    "@bublu/inventory-sync": "workspace:*",
    "@bublu/executive-orchestrator": "workspace:*",
    "@bublu/portfolio": "workspace:*",
    "@bublu/forecasting": "workspace:*"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
