generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum ProductStatus { DISCOVERED SHORTLISTED APPROVED REJECTED LISTED PAUSED }
enum ListingStatus { DRAFT PENDING_REVIEW READY PUBLISHED FAILED }
enum OrderStatus { RECEIVED VALIDATING SUBMITTED_TO_CJ PROCESSING SHIPPED DELIVERED EXCEPTION CANCELED REFUNDED }
enum RecommendationType { PRICE_RAISE PRICE_LOWER PAUSE_PRODUCT LAUNCH_PRODUCT RESTOCK IMPROVE_LISTING }
model Store { id String @id @default(uuid()); name String; marketplace String @default("amazon"); marketplaceId String?; sellerId String?; currency String @default("USD"); active Boolean @default(true); listings AmazonListing[]; orders Order[]; reports ExecutiveReport[]; metrics StoreMetric[]; createdAt DateTime @default(now()) }
model SupplierProduct { id String @id @default(uuid()); cjProductId String @unique; sku String @unique; name String; description String?; imageUrl String?; category String?; cost Decimal @db.Decimal(12,2); estimatedShipping Decimal @default(0) @db.Decimal(12,2); stock Int @default(0); warehouse String?; supplierReliability Float @default(50); shippingSpeedScore Float @default(50); reviewSentimentScore Float @default(50); trendScore Float @default(0); competitionScore Float @default(50); riskScore Float @default(50); recommendedPrice Decimal? @db.Decimal(12,2); expectedMargin Float?; finalScore Float?; status ProductStatus @default(DISCOVERED); raw Json?; listings AmazonListing[]; inventory SupplierInventory[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([status,finalScore]) }
model SupplierInventory { id String @id @default(uuid()); productId String; quantity Int; warehouse String?; source String @default("cj"); product SupplierProduct @relation(fields:[productId],references:[id],onDelete:Cascade); capturedAt DateTime @default(now()); @@index([productId,capturedAt]) }
model AmazonListing { id String @id @default(uuid()); storeId String; productId String; asin String?; sku String; title String; bullets String[]; description String; backendTerms String; seoKeywords String[]; aPlusRecommendations Json?; faq Json?; status ListingStatus @default(DRAFT); currentPrice Decimal? @db.Decimal(12,2); store Store @relation(fields:[storeId],references:[id]); product SupplierProduct @relation(fields:[productId],references:[id]); competitors CompetitorSnapshot[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([storeId,sku]) }
model PricingSnapshot { id String @id @default(uuid()); productId String; productCost Decimal @db.Decimal(12,2); shippingCost Decimal @db.Decimal(12,2); amazonFees Decimal @db.Decimal(12,2); adAllowance Decimal @default(0) @db.Decimal(12,2); targetMargin Float; minimumSafePrice Decimal @db.Decimal(12,2); optimalPrice Decimal @db.Decimal(12,2); maximumCompetitivePrice Decimal @db.Decimal(12,2); createdAt DateTime @default(now()); @@index([productId,createdAt]) }
model CompetitorSnapshot { id String @id @default(uuid()); listingId String; competitorAsin String; sellerName String?; price Decimal? @db.Decimal(12,2); rating Float?; reviewCount Int?; inStock Boolean?; keywordRank Int?; listingQuality Float?; listing AmazonListing @relation(fields:[listingId],references:[id],onDelete:Cascade); capturedAt DateTime @default(now()); @@index([listingId,capturedAt]) }
model Order { id String @id @default(uuid()); storeId String; amazonOrderId String @unique; status OrderStatus @default(RECEIVED); revenue Decimal @db.Decimal(12,2); productCost Decimal @default(0) @db.Decimal(12,2); amazonFees Decimal @default(0) @db.Decimal(12,2); advertisingCost Decimal @default(0) @db.Decimal(12,2); refundAmount Decimal @default(0) @db.Decimal(12,2); netProfit Decimal @default(0) @db.Decimal(12,2); cjOrderId String?; trackingNumber String?; exceptionReason String?; store Store @relation(fields:[storeId],references:[id]); items OrderItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([storeId,status,createdAt]) }
model OrderItem { id String @id @default(uuid()); orderId String; sku String; quantity Int; unitPrice Decimal @db.Decimal(12,2); unitCost Decimal @db.Decimal(12,2); order Order @relation(fields:[orderId],references:[id],onDelete:Cascade) }
model Recommendation { id String @id @default(uuid()); type RecommendationType; entityType String; entityId String; title String; rationale String; expectedImpact String?; priority Int @default(50); status String @default("OPEN"); createdAt DateTime @default(now()); @@index([status,priority]) }
model ExecutiveReport { id String @id @default(uuid()); storeId String; reportDate DateTime; orders Int; revenue Decimal @db.Decimal(12,2); productCosts Decimal @db.Decimal(12,2); amazonFees Decimal @db.Decimal(12,2); advertisingCost Decimal @db.Decimal(12,2); refunds Decimal @db.Decimal(12,2); netProfit Decimal @db.Decimal(12,2); topProduct String?; topCategory String?; biggestOpportunity String?; biggestRisk String?; recommendations Json; executiveSummary String; store Store @relation(fields:[storeId],references:[id]); createdAt DateTime @default(now()); @@unique([storeId,reportDate]) }


enum AlertSeverity { INFO WARNING CRITICAL }
enum AutomationAction { ALERT SUGGEST_PRICE APPLY_PRICE PAUSE_LISTING CREATE_DRAFT SUBMIT_FULFILLMENT }
model StoreMetric { id String @id @default(uuid()); storeId String; date DateTime; orders Int @default(0); revenue Decimal @default(0) @db.Decimal(14,2); cogs Decimal @default(0) @db.Decimal(14,2); amazonFees Decimal @default(0) @db.Decimal(14,2); adSpend Decimal @default(0) @db.Decimal(14,2); refunds Decimal @default(0) @db.Decimal(14,2); netProfit Decimal @default(0) @db.Decimal(14,2); margin Float @default(0); roas Float?; store Store @relation(fields:[storeId],references:[id],onDelete:Cascade); @@unique([storeId,date]); @@index([storeId,date]) }
model OpportunityAlert { id String @id @default(uuid()); storeId String?; productId String?; type String; title String; evidence Json; opportunityScore Float; recommendedAction String; severity AlertSeverity @default(INFO); status String @default("OPEN"); createdAt DateTime @default(now()); @@index([status,opportunityScore]); @@index([storeId,createdAt]) }
model InventoryAlert { id String @id @default(uuid()); productId String; type String; currentStock Int; threshold Int; severity AlertSeverity; status String @default("OPEN"); createdAt DateTime @default(now()); resolvedAt DateTime?; @@index([status,severity]) }
model AutomationRule { id String @id @default(uuid()); storeId String?; name String; triggerType String; conditions Json; action AutomationAction; approvalRequired Boolean @default(true); active Boolean @default(true); lastTriggeredAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([active,triggerType]) }
model AutomationRun { id String @id @default(uuid()); ruleId String; entityType String; entityId String; status String; input Json; output Json?; error String?; startedAt DateTime @default(now()); completedAt DateTime?; @@index([ruleId,startedAt]); @@index([status,startedAt]) }
model KeywordRanking { id String @id @default(uuid()); listingId String; keyword String; rank Int?; searchVolume Int?; capturedAt DateTime @default(now()); @@index([listingId,keyword,capturedAt]) }
model AdSpendRecord { id String @id @default(uuid()); storeId String; campaignId String; campaignName String?; spend Decimal @db.Decimal(14,2); sales Decimal @default(0) @db.Decimal(14,2); clicks Int @default(0); impressions Int @default(0); date DateTime; @@unique([storeId,campaignId,date]); @@index([storeId,date]) }
model SyncCheckpoint { id String @id @default(uuid()); integration String; resource String; storeId String?; cursor String?; lastSuccessfulAt DateTime?; status String @default("IDLE"); error String?; updatedAt DateTime @updatedAt; @@unique([integration,resource,storeId]) }


enum DecisionStatus { PROPOSED AWAITING_APPROVAL APPROVED REJECTED EXECUTED FAILED }
model RevenueForecast { id String @id @default(uuid()); storeId String; horizonDays Int; method String; projectedRevenue Decimal @db.Decimal(14,2); projectedProfit Decimal @db.Decimal(14,2); lowerBound Decimal @db.Decimal(14,2); upperBound Decimal @db.Decimal(14,2); assumptions Json; generatedAt DateTime @default(now()); @@index([storeId,generatedAt]) }
model SupplierHealthSnapshot { id String @id @default(uuid()); supplier String; stockAvailability Float; shippingSuccessRate Float; returnRate Float; lateShipmentRate Float; cancellationRate Float; healthScore Float; status String; capturedAt DateTime @default(now()); @@index([supplier,capturedAt]) }
model PortfolioSnapshot { id String @id @default(uuid()); totalStores Int; activeStores Int; totalRevenue Decimal @db.Decimal(14,2); totalProfit Decimal @db.Decimal(14,2); averageMargin Float; topStoreId String?; weakStoreIds String[]; details Json; capturedAt DateTime @default(now()) }
model ExecutiveBriefing { id String @id @default(uuid()); scope String; scopeId String?; title String; summary String; opportunities Json; risks Json; recommendations Json; sourceData Json; generatedAt DateTime @default(now()); @@index([scope,scopeId,generatedAt]) }
model AutonomousDecision { id String @id @default(uuid()); storeId String?; entityType String; entityId String; action String; rationale String; confidence Float; riskLevel String; approvalRequired Boolean @default(true); status DecisionStatus @default(PROPOSED); input Json; result Json?; approvedBy String?; approvedAt DateTime?; executedAt DateTime?; createdAt DateTime @default(now()); @@index([status,riskLevel,createdAt]) }
model CopilotConversation { id String @id @default(uuid()); storeId String?; sessionId String; question String; answer Json; mode String @default("executive"); createdAt DateTime @default(now()); @@index([sessionId,createdAt]) }
