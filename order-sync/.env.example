# Copy to .env on the VPS (chmod 600). Never commit .env.

# --- CJdropshipping (CJ -> Settings -> API -> generate API key) ---
CJ_API_KEY=
CJ_STORE_NAME=loveandcare-amazon
CJ_FROM_COUNTRY=US
CJ_SANDBOX=false

# --- Amazon SP-API (Seller Central -> Develop apps -> private app) ---
LWA_APP_ID=
LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_MARKETPLACE_ID=ATVPDKIKX0DER

# --- Rules ---
BUBLU_DRY_RUN=true          # keep true for the first week
BUBLU_MIN_MARGIN=0.30
BUBLU_AMAZON_FEE_RATE=0.15
BUBLU_MIN_CJ_BALANCE=50
BUBLU_LOOKBACK_DAYS=7

# --- Alerts (optional; leave blank to only log) ---
ALERT_EMAIL_TO=shaheenarifch@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agents@getservices.ai
